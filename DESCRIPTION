Package: breezeml
Title: A Graphical User Interface for NPSdataverse: making EML metadata
Version: 0.0.1
Authors@R: c(
    person(given="Robert", family="Baker", email="robert_baker@nps.gov",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-7591-5035")),
    person(given="Sarah", family="Wright", email="sarah_wright@nps.gov",
